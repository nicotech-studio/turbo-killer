    "Reference only; not a minimum or maximum CPU frequency.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅作参考，不表示 CPU 的最低或最高频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅供參考，不代表 CPU 的最低或最高頻率。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参照値です。CPU の最低・最高周波数ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "참고 값이며 CPU의 최저 또는 최고 주파수가 아닙니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur als Referenz, keine minimale oder maximale CPU-Frequenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeur de référence, ni fréquence minimale ni maximale du CPU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo como referencia; no es la frecuencia mínima ni máxima de la CPU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas referência; não é a frequência mínima nem máxima da CPU."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas referência; não é a frequência mínima nem máxima da CPU."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un riferimento, non la frequenza minima o massima della CPU."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Справочное значение, не минимальная и не максимальная частота CPU."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca referanstır; CPU’nun en düşük veya en yüksek frekansı değildir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya acuan, bukan frekuensi CPU minimum atau maksimum."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ để tham khảo, không phải tần số CPU tối thiểu hoặc tối đa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قيمة مرجعية فقط وليست أدنى أو أعلى تردد للمعالج."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעיון בלבד; זה אינו תדר CPU מינימלי או מרבי."
          }
        }
      }
    },
    "The CPU's nominal base frequency, not its current, minimum or maximum frequency.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 的标称基础频率，不是当前频率，也不是最低或最高频率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU 的標稱基礎頻率，不是目前頻率，也不是最低或最高頻率。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU の公称ベース周波数です。現在の周波数や最低・最高周波数ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU의 공칭 기본 주파수이며, 현재 주파수나 최저·최고 주파수가 아닙니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die nominelle Basisfrequenz der CPU, nicht ihre aktuelle, minimale oder maximale Frequenz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fréquence de base nominale du CPU, et non sa fréquence actuelle, minimale ou maximale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Frecuencia base nominal de la CPU, no su frecuencia actual, mínima ni máxima."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frequência base nominal da CPU, não a frequência atual, mínima ou máxima."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A frequência base nominal da CPU, não a frequência atual, mínima ou máxima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frequenza base nominale della CPU, non la frequenza attuale, minima o massima."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Номинальная базовая частота CPU, а не текущая, минимальная или максимальная частота."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CPU’nun nominal temel frekansıdır; geçerli, en düşük veya en yüksek frekansı değildir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frekuensi dasar nominal CPU, bukan frekuensi saat ini, minimum, atau maksimumnya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tần số cơ bản danh định của CPU, không phải tần số hiện tại, tối thiểu hoặc tối đa."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التردد الأساسي الاسمي للمعالج، وليس تردده الحالي أو الأدنى أو الأقصى."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תדר הבסיס הנקוב של ה-CPU, ולא התדר הנוכחי, המינימלי או המרבי שלו."
          }
        }
      }
    }
  },
  "version": "1.2"
}
