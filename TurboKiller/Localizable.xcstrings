    "The kernel extension must be approved in System Settings before it can be used.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する前に、システム設定でカーネル拡張を承認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하기 전에 시스템 설정에서 커널 확장을 승인해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前必须先在系统设置中批准该内核扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前必須先在系統設定中允許該核心延伸模組。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kernelerweiterung muss vor der Verwendung in den Systemeinstellungen genehmigt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extension du noyau doit être approuvée dans les Réglages Système avant utilisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes aprobar la extensión del kernel en Ajustes del Sistema antes de usarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão de kernel precisa ser aprovada nos Ajustes do Sistema antes do uso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão do kernel tem de ser aprovada nas Definições do Sistema antes de ser utilizada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estensione del kernel deve essere approvata nelle Impostazioni di Sistema prima dell’uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед использованием расширение ядра нужно одобрить в Системных настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekirdek uzantısı kullanılmadan önce Sistem Ayarları’nda onaylanmalıdır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstensi kernel harus disetujui di Pengaturan Sistem sebelum digunakan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phần mở rộng nhân phải được phê duyệt trong Cài đặt hệ thống trước khi sử dụng."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب الموافقة على امتداد النواة في إعدادات النظام قبل استخدامه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לאשר את הרחבת הליבה בהגדרות המערכת לפני השימוש."
          }
        }
      }
    },
    "The kernel extension was approved, but macOS requires a restart before it can be used.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カーネル拡張は承認されましたが、使用するには macOS の再起動が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "커널 확장이 승인되었지만 사용하려면 macOS를 재시동해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内核扩展已获批准，但 macOS 要求重新启动后才能使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核心延伸模組已獲允許，但 macOS 要求重新啟動後才能使用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kernelerweiterung wurde genehmigt, aber macOS erfordert vor der Verwendung einen Neustart."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’extension du noyau a été approuvée, mais macOS exige un redémarrage avant son utilisation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La extensión del kernel se ha aprobado, pero macOS requiere reiniciar antes de usarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão de kernel foi aprovada, mas o macOS exige uma reinicialização antes do uso."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A extensão do kernel foi aprovada, mas o macOS exige um reinício antes de a utilizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’estensione del kernel è stata approvata, ma macOS richiede un riavvio prima dell’uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расширение ядра одобрено, но macOS требует перезагрузки перед использованием."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çekirdek uzantısı onaylandı ancak kullanılabilmesi için macOS’un yeniden başlatılması gerekiyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
