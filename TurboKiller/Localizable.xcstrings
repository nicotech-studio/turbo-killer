    "History is kept for this session only. Gaps indicate sleep, paused monitoring or unavailable data.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史仅在本次运行期间保留。空缺表示睡眠、监控暂停或数据不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史僅保留於本次執行期間。空缺表示睡眠、監控暫停或無法取得資料。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴は今回の実行中のみ保持されます。空白はスリープ、監視の一時停止、またはデータの欠落を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 이번 실행 동안만 보관됩니다. 빈 구간은 잠자기, 모니터링 일시 정지 또는 데이터 없음을 나타냅니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf gilt nur für diese Sitzung. Lücken bedeuten Ruhezustand, pausierte Überwachung oder fehlende Daten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique est limité à cette session. Les lacunes indiquent une veille, une pause ou des données indisponibles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial solo se conserva durante esta sesión. Los huecos indican reposo, monitorización en pausa o datos no disponibles."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico é mantido apenas nesta sessão. Lacunas indicam repouso, monitoramento pausado ou dados indisponíveis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico é mantido apenas nesta sessão. As lacunas indicam pausa, suspensão ou dados indisponíveis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia è limitata alla sessione corrente. Le lacune indicano stop, monitoraggio sospeso o dati non disponibili."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "История хранится только в текущем сеансе. Пробелы означают сон, приостановку мониторинга или отсутствие данных."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş yalnızca bu oturumda tutulur. Boşluklar uyku, duraklatılmış izleme veya veri yokluğunu gösterir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hanya disimpan selama sesi ini. Celah menunjukkan tidur, pemantauan dijeda, atau data tidak tersedia."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lịch sử chỉ được giữ trong phiên này. Khoảng trống thể hiện chế độ ngủ, tạm dừng theo dõi hoặc không có dữ liệu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ السجل لهذه الجلسة فقط. تشير الفجوات إلى السكون أو توقف المراقبة أو عدم توفر البيانات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההיסטוריה נשמרת להפעלה זו בלבד. פערים מציינים שינה, ניטור מושהה או נתונים חסרים."
          }
        }
      }
    },
    "Hover over the chart to inspect a sample.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将指针移到图表上以查看采样详情。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將指標移到圖表上以查看取樣詳情。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グラフにポインタを合わせるとサンプルの詳細を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차트에 포인터를 올려 샘플을 확인하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie auf das Diagramm, um einen Messwert zu prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez le graphique pour examiner une mesure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el puntero por la gráfica para examinar una muestra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o cursor sobre o gráfico para examinar uma amostra."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe o cursor sobre o gráfico para examinar uma amostra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il puntatore sul grafico per esaminare un campione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведите указатель на график для просмотра измерения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir örneği incelemek için işaretçiyi grafiğin üzerine getirin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan penunjuk ke grafik untuk memeriksa sampel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di con trỏ lên biểu đồ để xem chi tiết mẫu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرّر المؤشر فوق الرسم لفحص عينة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להעביר את המצביע מעל התרשים לבדיקת דגימה."
          }
        }
      }
    },
    "Keep up to one hour of history in memory while TurboKiller is running. When background recording is off, history is recorded only while the Frequency Monitor window is open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 运行期间，在内存中保留最多一小时的历史。关闭后台记录后，仅在频率监控窗口打开时记录历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller 執行期間，在記憶體保留最多一小時的歷史。關閉背景記錄後，僅在頻率監控視窗開啟時記錄歷史。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller の実行中、最大 1 時間の履歴をメモリに保持します。バックグラウンド記録がオフの場合、周波数モニタのウインドウを開いている間のみ記録します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller가 실행되는 동안 최대 1시간의 기록을 메모리에 보관합니다. 백그라운드 기록을 끄면 주파수 모니터 창이 열려 있을 때만 기록합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Während TurboKiller läuft, bleibt bis zu eine Stunde Verlauf im Arbeitsspeicher. Ohne Hintergrundaufzeichnung wird nur bei geöffnetem Frequenzmonitor aufgezeichnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’à une heure d’historique est conservée en mémoire pendant l’exécution de TurboKiller. Sans enregistrement en arrière-plan, seules les périodes où le moniteur est ouvert sont enregistrées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva hasta una hora de historial en memoria mientras TurboKiller está abierto. Sin registro en segundo plano, solo se registra mientras la ventana del monitor está abierta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até uma hora de histórico é mantida na memória enquanto o TurboKiller está aberto. Com o registro em segundo plano desativado, o histórico só é registrado enquanto a janela do monitor está aberta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É mantida até uma hora de histórico na memória enquanto o TurboKiller está aberto. Sem registo em segundo plano, o histórico só é registado enquanto a janela do monitor está aberta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a un’ora di cronologia resta in memoria mentre TurboKiller è aperto. Senza registrazione in background, la cronologia viene registrata solo mentre la finestra del monitor è aperta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время работы TurboKiller в памяти хранится до часа истории. Если фоновая запись отключена, история записывается только при открытом окне монитора частоты."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller çalışırken bellekte en fazla bir saatlik geçmiş tutulur. Arka planda kayıt kapalıysa geçmiş yalnızca frekans izleyicisi penceresi açıkken kaydedilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat hingga satu jam disimpan di memori selama TurboKiller berjalan. Jika perekaman latar belakang mati, riwayat hanya direkam saat jendela monitor frekuensi terbuka."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tối đa một giờ lịch sử trong bộ nhớ khi TurboKiller đang chạy. Nếu tắt ghi trong nền, lịch sử chỉ được ghi khi cửa sổ theo dõi tần số đang mở."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ سجل يصل إلى ساعة في الذاكرة أثناء تشغيل TurboKiller. عند إيقاف التسجيل في الخلفية، يُسجل فقط عندما تكون نافذة مراقب التردد مفتوحة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עד שעה של היסטוריה נשמרת בזיכרון בזמן ש-TurboKiller פועל. כשהקלטה ברקע כבויה, ההיסטוריה מוקלטת רק כשחלון ניטור התדר פתוח."
          }
        }
      }
    },
