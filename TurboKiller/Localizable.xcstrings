    "The menu bar, popover and chart share the same samples. Shorter intervals may use more energy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏、弹出面板和图表共用采样数据。较短的间隔可能增加耗电。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選單列、彈出面板與圖表共用取樣資料。較短的間隔可能增加耗電。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバー、ポップオーバー、グラフは同じサンプルを使用します。間隔を短くすると消費電力が増える場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대, 팝오버와 차트는 같은 샘플을 사용합니다. 간격이 짧으면 에너지 사용량이 늘어날 수 있습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste, Popover und Diagramm nutzen dieselben Messwerte. Kürzere Intervalle können mehr Energie verbrauchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre des menus, le panneau et le graphique utilisent les mêmes mesures. Des intervalles courts peuvent consommer plus d’énergie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de menús, el panel y la gráfica comparten las mismas muestras. Los intervalos cortos pueden consumir más energía."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de menus, o painel e o gráfico usam as mesmas amostras. Intervalos menores podem consumir mais energia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de menus, o painel e o gráfico usam as mesmas amostras. Intervalos menores podem consumir mais energia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Barra dei menu, pannello e grafico condividono gli stessi campioni. Intervalli brevi possono consumare più energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка меню, панель и график используют одни и те же измерения. Короткие интервалы могут увеличить расход энергии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu, açılır panel ve grafik aynı örnekleri kullanır. Kısa aralıklar daha fazla enerji tüketebilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bar menu, panel, dan grafik memakai sampel yang sama. Interval pendek dapat memakai lebih banyak energi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh menu, bảng bật lên và biểu đồ dùng chung mẫu. Khoảng lấy mẫu ngắn có thể tốn nhiều năng lượng hơn."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم شريط القوائم واللوحة والرسم العينات نفسها. قد تستهلك الفواصل الأقصر طاقة أكثر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שורת התפריטים, החלונית והתרשים משתמשים באותן דגימות. מרווחים קצרים עשויים לצרוך יותר אנרגיה."
          }
        }
      }
    },
