    "Automatically open TurboKiller when you log in to your Mac.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macへのログイン時にTurboKillerを自動的に開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에 로그인할 때 TurboKiller를 자동으로 엽니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Mac 时自动打开 TurboKiller。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入 Mac 時自動開啟 TurboKiller。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboKiller automatisch öffnen, wenn du dich am Mac anmeldest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir automatiquement TurboKiller à l’ouverture de session sur votre Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir TurboKiller automáticamente al iniciar sesión en tu Mac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o TurboKiller automaticamente ao iniciar a sessão no Mac."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir o TurboKiller automaticamente ao iniciar sessão no Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri automaticamente TurboKiller quando accedi al Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически открывать TurboKiller при входе в систему на Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’inizde oturum açtığınızda TurboKiller’ı otomatik olarak açın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka TurboKiller secara otomatis saat Anda masuk ke Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động mở TurboKiller khi bạn đăng nhập vào máy Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتح TurboKiller تلقائيًا عند تسجيل الدخول إلى Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת TurboKiller אוטומטית בעת ההתחברות ל-Mac."
          }
        }
      }
    },
